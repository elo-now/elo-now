{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "elo.now",
  "version": "0.1.0",
  "identifier": "now.elo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "elo.now",
        "width": 1180,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        "main",
        "mobile-invitations"
      ]
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "elo"
          ],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": [
          "elo"
        ]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0",
      "bundleVersion": "1005"
    },
    "android": {
      "versionCode": 1005
    },
    "macOS": {
      "bundleVersion": "1004",
      "minimumSystemVersion": "11.0"
    }
  }
}
