{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "elo.now",
  "version": "1.0.2",
  "identifier": "now.elo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "elo.now",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1180,
        "height": 800,
        "minWidth": 820,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https: wss:; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        "main",
        "mobile-invitations",
        "desktop-window"
      ]
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "elo"
          ],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": [
          "elo"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0",
      "developmentTeam": "F3HJA47BQU",
      "bundleVersion": "1093"
    },
    "android": {
      "versionCode": 1093
    },
    "macOS": {
      "infoPlist": "macos/Info.plist",
      "entitlements": "macos/Entitlements.plist",
      "bundleVersion": "1093",
      "minimumSystemVersion": "11.0"
    }
  }
}
