[Unit]
Description=elo.now aggregate operator statistics
After=elo-hosting.service

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/bin/python3 /opt/elo/hosting/collect.py --config /etc/elo-hosting/metrics.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/elo-hosting
