# Defense in depth: build only the context produced by bundle.py.
**
!Cargo.toml
!Cargo.lock
!apps/
!apps/desktop/
!apps/desktop/src/
!apps/desktop/src/locales/
!apps/desktop/src/locales/native.en.json
!rust-toolchain.toml
!LICENSE
!crates/
!crates/elo-core/**
!crates/elo-team/**
!crates/elo-witness/**
!crates/elo-storage/**
!crates/elo-wake/**
!crates/elo-call-service/**
!migrations/
!migrations/*.sql
!protocol/
!protocol/reactions.json
!protocol/fixtures/
!protocol/fixtures/chat-message-v1.*
!deploy/
!deploy/containers/
!deploy/containers/Dockerfile
!deploy/containers/entrypoint.sh
!deploy/containers/activate.py
!deploy/containers/verify_lock.py
!deploy/containers/wake.py
!deploy/containers/install_mega.sh
!deploy/storage/
!deploy/storage/mega_folder.py
**/.private/**
**/.git/**
**/target/**
**/build/**
**/runtime/**
