# Defense in depth: build only the context produced by bundle.py.
**
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!LICENSE
!crates/
!crates/elo-core/**
!crates/elo-team/**
!crates/elo-witness/**
!crates/elo-storage/**
!migrations/
!migrations/*.sql
!protocol/
!protocol/reactions.json
!protocol/fixtures/
!protocol/fixtures/chat-message-v1.*
!deploy/
!deploy/containers/
!deploy/containers/Dockerfile
!deploy/containers/entrypoint.sh
!deploy/containers/activate.py
!deploy/containers/verify_lock.py
**/.private/**
**/.git/**
**/target/**
**/build/**
**/runtime/**
**/credentials/**
**/*.key
**/*.pem
**/*.sqlite*
**/*.age
**/.env*
