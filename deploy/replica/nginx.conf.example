# Place these directives inside nginx's http {} context.
# Replace the example hostname and certificate paths before deployment.
limit_req_zone $binary_remote_addr zone=elo_replica:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=elo_realtime_connect:1m rate=2r/s;
limit_conn_zone $binary_remote_addr zone=elo_realtime_sockets:1m;
log_format elo_replica_minimal '$time_iso8601 $request_method $status $body_bytes_sent $request_time';

server {
    listen 443 ssl;
    server_name replica.example.org;
    ssl_certificate /etc/letsencrypt/live/replica.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/replica.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 16m;
    client_body_timeout 30s;
    access_log /var/log/nginx/elo-replica-access.log elo_replica_minimal;
    error_log /var/log/nginx/elo-replica-error.log warn;

    location = /v1/realtime {
        limit_req zone=elo_realtime_connect burst=12 nodelay;
        limit_req_status 429;
        limit_conn elo_realtime_sockets 64;
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_cache off;
        proxy_next_upstream off;
        proxy_connect_timeout 5s;
        proxy_send_timeout 35s;
        proxy_read_timeout 3600s;
    }
    location /v1/ {
        limit_req zone=elo_replica burst=80 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
        proxy_next_upstream off;
        proxy_connect_timeout 5s;
        proxy_send_timeout 35s;
        proxy_read_timeout 35s;
    }
    location / {
        return 404;
    }
}
