[Unit]
Description=elo.now independent attachment storage broker
After=network-online.target
Wants=network-online.target

[Service]
User=elo-storage
Group=elo-storage
ExecStart=/opt/elo/bin/elo-storage --config /etc/elo/storage/config.json
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=elo-storage
StateDirectoryMode=0700
RuntimeDirectory=elo-storage
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/elo-storage /run/elo-storage
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
MemoryMax=768M
MemorySwapMax=0
TasksMax=128
KillMode=control-group
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
