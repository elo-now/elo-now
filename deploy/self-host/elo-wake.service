[Unit]
Description=elo.now mobile notifications and calls
After=network-online.target
Wants=network-online.target

[Service]
User=elo-wake
Group=elo-wake
UMask=0077
ExecStart=/opt/elo/bin/elo-wake --service-account /etc/elo/wake/firebase.json --database /var/lib/elo/wake/wake.sqlite --public-url https://chat.example.org --listen 127.0.0.1:8788 --call-key /etc/elo/wake/calls.key --call-listen 127.0.0.1:8794 --apns-config /etc/elo/wake/apns.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/elo/wake

[Install]
WantedBy=multi-user.target
