[Unit]
Description=elo.now call control
After=network-online.target elo-host.service elo-media.service
Wants=network-online.target
Requires=elo-host.service elo-media.service

[Service]
User=elo-call
Group=elo-call
UMask=0077
ExecStart=/opt/elo/bin/elo-call-service --config /etc/elo/call/config.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
CapabilityBoundingSet=
SystemCallArchitectures=native
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
LimitNOFILE=8192
TasksMax=512
ReadWritePaths=/var/lib/elo/call

[Install]
WantedBy=multi-user.target
